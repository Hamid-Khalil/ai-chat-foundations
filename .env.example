GOOGLE_API_KEY=
TAVILY_API_KEY=
GROQ_API_KEY=
USE_GROQ=false

# Week 8 RAG Settings
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_BATCH_SIZE=32
VECTOR_STORE_DIR=data/chroma
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K_DEFAULT=4
RAG_TOP_K_MAX=8
RAG_MIN_SCORE=0.66
RAG_MAX_CONTEXT_CHARS=6000
RAG_MAX_QUESTION_CHARS=500
RAG_MAX_UPLOAD_BYTES=200000
RAG_MAX_DOCUMENTS=20


# Week 9 — MongoDB Persistence
MONGO_INITDB_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MONGODB_URI=mongodb://app_user:CHANGE_ME@127.0.0.1:27017/ai_chat_foundations?authSource=ai_chat_foundations
MONGODB_DB=ai_chat_foundations
MONGODB_TIMEOUT_MS=3000
HISTORY_MAX_MESSAGES=18
CONVERSATION_MAX_MESSAGES=200